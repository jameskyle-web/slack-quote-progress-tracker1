# ── Slack App Credentials ──────────────────────────────────────────────────────
# Found in your Slack App dashboard at https://api.slack.com/apps

# Bot Token (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing Secret (used to verify requests from Slack)
SLACK_SIGNING_SECRET=your-signing-secret-here

# ── Socket Mode (recommended for Replit) ───────────────────────────────────────
# Set to "true" to use Socket Mode (no public URL needed).
# Set to "false" to use HTTP mode (requires a public URL).
SLACK_SOCKET_MODE=true

# App-Level Token — ONLY needed when SLACK_SOCKET_MODE=true (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token-here

# ── Required Team Member Slack User IDs ────────────────────────────────────────
# To find a user's ID: open their profile in Slack → "More" (three dots) → "Copy member ID"
SLACK_USER_LEANDER=U0000000000
SLACK_USER_JAMES=U0000000001
SLACK_USER_KUNIKKA=U0000000002
SLACK_USER_LORE=U0000000003

# ── Supabase ────────────────────────────────────────────────────────────────────
# Already configured by Bolt — do not change these unless running locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Server ──────────────────────────────────────────────────────────────────────
PORT=3000
